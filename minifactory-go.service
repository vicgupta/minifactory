[Unit]
Description=minifactory cycle (queue -> sandbox -> PR -> sync)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/minifactory-go
Environment=MINIFACTORY_DIR=/root/minifactory-go
ExecStart=/bin/bash -c '/root/.local/bin/minifactory run-once && /root/.local/bin/minifactory sync && /root/.local/bin/minifactory poll'
